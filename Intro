local Word = "MEOW HUB"
local Letters = {}

for i = 1, #Word do
    local Char = Word:sub(i, i)

    local Letter = Instance.new("TextLabel")
    Letter.AnchorPoint = Vector2.new(0.5, 0.5)
    Letter.BackgroundTransparency = 1
    Letter.Size = UDim2.fromScale(0.115, 0.9)

    local X = 0.09 + (i - 1) * (0.82 / math.max(#Word - 1, 1))
    local OffsetY = ((i % 3) - 2) * 0.035

    Letter.Position = UDim2.fromScale(X, -0.4)
    Letter.Text = Char
    Letter.TextScaled = true
    Letter.Font = Enum.Font.Antique
    Letter.TextColor3 = Color3.fromRGB(255, 235, 235)
    Letter.TextStrokeColor3 = Color3.fromRGB(255, 0, 15)
    Letter.TextStrokeTransparency = 0.08
    Letter.Rotation = ((i * 11) % 9) - 4
    Letter.Parent = TitleHolder

    local Constraint = Instance.new("UITextSizeConstraint")
    Constraint.MaxTextSize = 110
    Constraint.MinTextSize = 20
    Constraint.Parent = Letter

    local Glow = Instance.new("TextLabel")
    Glow.AnchorPoint = Vector2.new(0.5, 0.5)
    Glow.Position = UDim2.fromOffset(4, 5)
    Glow.Size = UDim2.fromScale(1, 1)
    Glow.BackgroundTransparency = 1
    Glow.Text = Char
    Glow.TextScaled = true
    Glow.Font = Enum.Font.Antique
    Glow.TextColor3 = Color3.fromRGB(255, 0, 10)
    Glow.TextTransparency = 0.45
    Glow.ZIndex = 0
    Glow.Parent = Letter

    local GlowConstraint = Instance.new("UITextSizeConstraint")
    GlowConstraint.MaxTextSize = 110
    GlowConstraint.MinTextSize = 20
    GlowConstraint.Parent = Glow

    Letters[i] = {Object = Letter, X = X, Y = 0.5 + OffsetY}
end

