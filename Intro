-- Falling title animation
for i, Data in ipairs(Letters) do
    task.delay((i - 1) * 0.075, function()
        TweenService:Create(
            Data.Object,
            TweenInfo.new(0.65, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Position = UDim2.fromScale(Data.X, Data.Y)}
        ):Play()
    end)
