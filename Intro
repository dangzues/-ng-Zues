    TweenService:Create(Loading, TweenInfo.new(0.4), {TextTransparency = 0.1}):Play()
end)

-- Loading animation
for Value = 0, 100 do
    local Ratio = Value / 100

    TweenService:Create(
        Progress,
        TweenInfo.new(0.025, Enum.EasingStyle.Linear),
        {Size = UDim2.fromScale(Ratio * 0.976, 0.76)}
    ):Play()

    Percent.Text = tostring(Value) .. "%"
    task.wait(0.018 + math.random() * 0.012)
end

task.wait(0.5)

-- Fade out
local FadeInfo = TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

for _, Object in ipairs(Gui:GetDescendants()) do
    if Object:IsA("TextLabel") then
        TweenService:Create(Object, FadeInfo, {
            TextTransparency = 1,
            TextStrokeTransparency = 1
        }):Play()
    elseif Object:IsA("Frame") then
        TweenService:Create(Object, FadeInfo, {
            BackgroundTransparency = 1
        }):Play()
    elseif Object:IsA("UIStroke") then
        TweenService:Create(Object, FadeInfo, {
            Transparency = 1
        }):Play()
    end
end

task.wait(0.7)
