--========================
-- DRAWING OBJECTS
--========================
local ESPObjects = {}

local function CreateESP(player)

    if player == LocalPlayer then
        return
    end

    local Data = {
        Box = Instance.new("Frame"),
        Name = Instance.new("TextLabel"),
        Tracer = Instance.new("Frame"),
        Distance = Instance.new("TextLabel")
    }

    Data.Box.BackgroundTransparency = 1
    Data.Box.BorderSizePixel = 2
    Data.Box.BorderColor3 = Settings.BoxColor
    Data.Box.Visible = false
    Data.Box.Parent = GUI

    Data.Name.BackgroundTransparency = 1
    Data.Name.TextColor3 = Color3.new(1,1,1)
    Data.Name.TextStrokeTransparency = 0
    Data.Name.TextSize = 13
    Data.Name.Font = Enum.Font.GothamBold
    Data.Name.Visible = false
    Data.Name.Parent = GUI

    Data.Distance.BackgroundTransparency = 1
    Data.Distance.TextColor3 = Color3.fromRGB(0,170,255)
    Data.Distance.TextStrokeTransparency = 0
    Data.Distance.TextSize = 12
    Data.Distance.Font = Enum.Font.Gotham
    Data.Distance.Visible = false
    Data.Distance.Parent = GUI

    Data.Tracer.BackgroundColor3 = Settings.TracerColor
    Data.Tracer.BorderSizePixel = 0
    Data.Tracer.AnchorPoint = Vector2.new(0.5,0.5)
    Data.Tracer.Visible = false
    Data.Tracer.Parent = GUI

    ESPObjects[player] = Data
end

local function RemoveESP(player)
    local data = ESPObjects[player]

    if data then
        for _,obj in pairs(data) do
            obj:Destroy()
        end
    end

    ESPObjects[player] = nil
end

for _,player in ipairs(Players:GetPlayers()) do
    CreateESP(player)
end

Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

--========================
-- HELPER
--========================
local function SetTracer(frame, from, to)

    local dx = to.X - from.X
    local dy = to.Y - from.Y

    local length = math.sqrt(dx*dx + dy*dy)
    local angle = math.deg(math.atan2(dy,dx))

    frame.Position = UDim2.fromOffset(
        (from.X + to.X)/2,
        (from.Y + to.Y)/2
    )

    frame.Size = UDim2.fromOffset(length,2)
    frame.Rotation = angle
end

--========================
-- UPDATE ESP
--========================
RunService.RenderStepped:Connect(function()

    FOV.Visible = Settings.FOV

    for player,data in pairs(ESPObjects) do

        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not character or not humanoid or humanoid.Health <= 0 or not root then

            data.Box.Visible = false
            data.Name.Visible = false
            data.Distance.Visible = false
            data.Tracer.Visible = false

            continue
        end

        local distance = (root.Position - Camera.CFrame.Position).Magnitude

        if not Settings.ESP or distance > Settings.ESPRange then

            data.Box.Visible = false
            data.Name.Visible = false
            data.Distance.Visible = false
            data.Tracer.Visible = false

            continue
        end

        local rootPos, rootVisible =
            Camera:WorldToViewportPoint(root.Position)

        local head = character:FindFirstChild("Head")

        if not head then
            continue
        end

        local headPos, headVisible =
            Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))

        if not rootVisible and not headVisible then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Distance.Visible = false
            data.Tracer.Visible = false
            continue
        end

        -- Box size
        local height = math.abs(rootPos.Y - headPos.Y) * 2.3
        local width = height * 0.55

        data.Box.Position = UDim2.fromOffset(
            rootPos.X - width/2,
            headPos.Y
        )

        data.Box.Size = UDim2.fromOffset(width,height)
        data.Box.BorderColor3 = Settings.BoxColor
        data.Box.Visible = Settings.Boxes

        -- Name
        data.Name.Text = player.DisplayName
        data.Name.Position = UDim2.fromOffset(
            rootPos.X,
            headPos.Y - 20
        )
        data.Name.Size = UDim2.fromOffset(150,20)
        data.Name.AnchorPoint = Vector2.new(0.5,0.5)
        data.Name.Visible = Settings.Names

        -- Distance
        data.Distance.Text =
            string.format("%d studs",distance)

        data.Distance.Position = UDim2.fromOffset(
            rootPos.X,
            headPos.Y + height + 5
        )

        data.Distance.Size = UDim2.fromOffset(150,18)
        data.Distance.AnchorPoint = Vector2.new(0.5,0)
        data.Distance.Visible = Settings.Distance

        -- Tracer
        local screenCenter = Vector2.new(
            Camera.ViewportSize.X/2,
            Camera.ViewportSize.Y
        )

        local target = Vector2.new(rootPos.X,rootPos.Y)

        SetTracer(
            data.Tracer,
            screenCenter,
            target
        )

        data.Tracer.BackgroundColor3 = Settings.TracerColor
        data.Tracer.Visible = Settings.Tracers
    end
end)

--========================
-- CHAMS / HIGHLIGHT
--========================
local Highlights = {}

local function AddHighlight(player)

    if player == LocalPlayer then
        return
    end

    player.CharacterAdded:Connect(function(character)

        task.wait(0.5)

        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.FillColor = Settings.ChamsColor
        highlight.OutlineColor = Color3.new(1,1,1)
        highlight.FillTransparency = 0.55
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = Settings.Chams
        highlight.Parent = character

        Highlights[player] = highlight
    end)
end

for _,player in ipairs(Players:GetPlayers()) do
    AddHighlight(player)
end

Players.PlayerAdded:Connect(AddHighlight)

--========================
-- RIGHT SHIFT = HIDE UI
--========================
UserInputService.InputBegan:Connect(function(input,gpe)

    if gpe then return end

    if input.KeyCode == Enum.KeyCode.RightShift then
        Main.Visible = not Main.Visible
    end
end)
