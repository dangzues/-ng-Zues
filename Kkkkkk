-- Variables
local homePosition = nil
local isFlying = false

-- Functions
local function setHomePosition()
    if not character or not rootPart then return end
    homePosition = rootPart.Position
    statusLabel.Text = "✅ Đã đặt vị trí!"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    print("Maru Hub: Đã đặt vị trí tại", homePosition)
end

local function flyHome()
    if not homePosition then
        statusLabel.Text = "⚠️ Chưa đặt vị trí!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        return
    end
    
    if isFlying then return end
    isFlying = true
    
    local startPos = rootPart.Position
    local targetPos = homePosition
    local height = 200
    local speed = 200
    
    -- Calculate positions
    local midPos = Vector3.new(startPos.X, startPos.Y + height, startPos.Z)
    local endPos = Vector3.new(targetPos.X, targetPos.Y, targetPos.Z)
    
    -- Calculate distance and time
    local distanceToHome = (startPos - endPos).Magnitude
    local totalTime = (distanceToHome / speed) + 1.5 -- 1.5s for going up
    
    statusLabel.Text = "✈️ Đang bay về nhà..."
    statusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    
    -- Fly up animation
    local upTween = TweenService:Create(rootPart, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = midPos
    })
    
    upTween:Play()
    upTween.Completed:Wait()
    
    -- Fly to home with path
    local flyTween = TweenService:Create(rootPart, TweenInfo.new(totalTime - 1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
        Position = endPos
    })
    
    flyTween:Play()
    flyTween.Completed:Wait()
    
    statusLabel.Text = "🏠 Đã về nhà!"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    isFlying = false
end

