--// Địt Mẹ Mày Giỏi Thì Skid Đi Soi Con Cặc Ba Mày Tuất Xem Con Cặc Thích Thì Skid Xong Thì Gửi Tik Tok BloxFruitv355 Mà show soi cái đéo
--// Mstree Hub Intro
--// Hiệu ứng: màn hình đen → 2 nửa tách ngang từ trên/xuống → chữ Mstree Hub màu cyan

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "MstreeHubIntro"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- Nền đen
local Background = Instance.new("Frame")
Background.Size = UDim2.fromScale(1, 1)
Background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Background.BorderSizePixel = 0
Background.Parent = gui

-- Hai mảnh màn hình
local Top = Instance.new("Frame")
Top.Size = UDim2.fromScale(1, 0.5)
Top.Position = UDim2.fromScale(0, 0)
Top.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Top.BorderSizePixel = 0
Top.ZIndex = 5
Top.Parent = gui

local Bottom = Instance.new("Frame")
Bottom.Size = UDim2.fromScale(1, 0.5)
Bottom.Position = UDim2.fromScale(0, 0.5)
Bottom.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Bottom.BorderSizePixel = 0
Bottom.ZIndex = 5
Bottom.Parent = gui

-- Đường cyan ở giữa
local Line = Instance.new("Frame")
Line.AnchorPoint = Vector2.new(0.5, 0.5)
Line.Position = UDim2.fromScale(0.5, 0.5)
Line.Size = UDim2.new(0, 0, 0, 3)
Line.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
Line.BorderSizePixel = 0
Line.ZIndex = 10
Line.Parent = gui

local LineGlow = Instance.new("UIStroke")
LineGlow.Color = Color3.fromRGB(0, 255, 255)
LineGlow.Thickness = 2
LineGlow.Transparency = 0.25
LineGlow.Parent = Line

-- Chữ Mstree Hub
local Title = Instance.new("TextLabel")
Title.AnchorPoint = Vector2.new(0.5, 0.5)
Title.Position = UDim2.fromScale(0.5, 0.5)
Title.Size = UDim2.new(0.8, 0, 0.2, 0)
Title.BackgroundTransparency = 1
Title.Text = "Mstree Hub"
Title.TextColor3 = Color3.fromRGB(0, 255, 255)
Title.TextStrokeColor3 = Color3.fromRGB(0, 80, 80)
Title.TextStrokeTransparency = 0
Title.TextScaled = true
Title.Font = Enum.Font.GothamBold
Title.TextTransparency = 1
Title.ZIndex = 8
Title.Parent = gui

-- Glow chữ
local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(0, 255, 255)
Stroke.Thickness = 1.5
Stroke.Transparency = 0.2
Stroke.Parent = Title

-- Tween info
local Fast = TweenInfo.new(
	0.7,
	Enum.EasingStyle.Quint,
	Enum.EasingDirection.Out
)

local Smooth = TweenInfo.new(
	0.9,
	Enum.EasingStyle.Quint,
	Enum.EasingDirection.InOut
)

-- 1. Kéo đường cyan ra
TweenService:Create(
	Line,
	TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
	{Size = UDim2.new(0.7, 0, 0, 3)}
):Play()

task.wait(0.35)

-- 2. Hiện chữ
TweenService:Create(
	Title,
	TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	{TextTransparency = 0}
):Play()

task.wait(0.8)

-- 3. Tách đôi ngang
-- Nửa trên đi lên
local TopTween = TweenService:Create(
	Top,
	Smooth,
	{Position = UDim2.fromScale(0, -0.5)}
)

-- Nửa dưới đi xuống
local BottomTween = TweenService:Create(
	Bottom,
	Smooth,
	{Position = UDim2.fromScale(0, 1)}
)

TopTween:Play()
BottomTween:Play()

-- Chữ biến mất cùng lúc
TweenService:Create(
	Title,
	TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
	{TextTransparency = 1}
):Play()

TweenService:Create(
	Line,
	TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
	{Size = UDim2.new(0, 0, 0, 3)}
):Play()

task.wait(1)

gui:Destroy()

