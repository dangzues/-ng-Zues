--==================================================

local FPSGui = Instance.new("ScreenGui")

FPSGui.Name = "RainbowFPS"
FPSGui.IgnoreGuiInset = true
FPSGui.ResetOnSpawn = false
FPSGui.DisplayOrder = 999999
FPSGui.ZIndexBehavior = Enum.ZIndexBehavior.Global

pcall(function()
    FPSGui.Parent = game:GetService("CoreGui")
end)

if not FPSGui.Parent then
    FPSGui.Parent =
        Player:WaitForChild("PlayerGui")
end

local FPSLabel = Instance.new("TextLabel")

FPSLabel.AnchorPoint =
    Vector2.new(0.5, 0)

FPSLabel.Position =
    UDim2.new(0.5, 0, 0, 8)

FPSLabel.Size =
    UDim2.new(0, 180, 0, 40)

FPSLabel.BackgroundTransparency = 1
FPSLabel.Text = "FPS: 0"
FPSLabel.TextSize = 24
FPSLabel.Font = Enum.Font.GothamBold
FPSLabel.TextStrokeTransparency = 0
FPSLabel.TextStrokeColor3 =
    Color3.new(0, 0, 0)

FPSLabel.ZIndex = 999999
FPSLabel.Parent = FPSGui

local Frames = 0
local LastTime = os.clock()

RunService.RenderStepped:Connect(function()

    Frames += 1

    local Now = os.clock()

    if Now - LastTime >= 0.5 then

        local FPS =
            math.floor(
                Frames /
                (Now - LastTime)
            )

        Frames = 0
        LastTime = Now

        FPSLabel.Text =
            "FPS: " .. FPS
    end
end)

task.spawn(function()

    local Hue = 0

    while FPSGui.Parent do

        Hue = (Hue + 0.003) % 1

        FPSLabel.TextColor3 =
            Color3.fromHSV(
                Hue,
                1,
                1
            )

        task.wait()
    end
end)

FPSTab:CreateToggle({
    Name = "🌈 Rainbow FPS",
    CurrentValue = true,
    Flag = "RainbowFPS",

    Callback = function(Value)
        FPSGui.Enabled = Value
    end
})

